<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.RichiesteBroadcastController"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <HBox alignment="TOP_LEFT" spacing="15.0">
            <Button text="Indietro" onAction="#handleBack"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="20.0" alignment="TOP_CENTER">
            <Label fx:id="titoloLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <TextArea fx:id="testoPaperArea" editable="false" wrapText="true" prefHeight="200" prefWidth="500"/>
            <Button text="Fai Offerta" onAction="#handleFaiOfferta"/>
        </VBox>
    </center>
</BorderPane>