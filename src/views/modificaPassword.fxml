<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.PasswordField?>


<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModificaPasswordController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <HBox alignment="TOP_LEFT">
            <padding>
                <Insets top="10.0"/>
            </padding>
            <children>
                <Button fx:id="backButton" text="Indietro" onAction="#handleHome"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <children>
                <Label text="Scrivi la vecchia password:">
                    <font>
                        <Font name="System" size="15.0"/>
                    </font>
                </Label>
                <PasswordField fx:id="vecchiaPasswordField" promptText="Vecchia password"/>

                <Label text="Scrivi la nuova password:">
                    <font>
                        <Font name="System" size="15.0"/>
                    </font>
                </Label>
                <PasswordField fx:id="nuovaPasswordField" promptText="Nuova password"/>

                <Label text="Scrivi di nuovo la nuova password:">
                    <font>
                        <Font name="System" size="15.0"/>
                    </font>
                </Label>
                <PasswordField fx:id="confermaNuovaPasswordField" promptText="Conferma nuova password"/>

                <Button text="Conferma" onAction="#handleConfirmPassword" minWidth="150"/>
                <Label fx:id="feedbackLabel" textFill="green"/>
            </children>
        </VBox>
    </center>

</BorderPane>