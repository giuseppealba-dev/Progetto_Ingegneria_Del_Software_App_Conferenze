<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ScegliArgomentiRevisoreController"
            prefHeight="400.0" prefWidth="600.0">
    <center>
        <VBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            <Label text="Seleziona gli argomenti di competenza" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <VBox fx:id="topicsContainer" spacing="10.0"/>
            <Button text="Conferma" onAction="#handleConferma" minWidth="120"/>
        </VBox>
    </center>
</BorderPane>