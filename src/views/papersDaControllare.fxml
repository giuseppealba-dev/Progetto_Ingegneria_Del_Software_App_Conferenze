<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.PapersDaControllareController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <HBox alignment="TOP_LEFT" spacing="15.0">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Button text="Indietro" onAction="#handleBack"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="20.0" alignment="TOP_CENTER">
                <padding>
                    <Insets top="20" right="30" bottom="20" left="30"/>
                </padding>
                <Label text="Paper finali inviati all'Editor:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <VBox fx:id="papersContainer" spacing="15.0">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

