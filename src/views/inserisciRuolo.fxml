<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.InserisciRuoloController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <HBox alignment="TOP_LEFT" spacing="15.0">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Button text="Indietro" onAction="#handleBack"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            <Label text="Inserisci Codice Ruolo" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <TextField fx:id="codiceField" promptText="Inserisci codice"/>
            <Label fx:id="ultimoCodiceLabel" text="Ultimo codice ricevuto: -" style="-fx-font-size: 13px;"/>
            <Button text="Conferma" onAction="#handleConferma" minWidth="120"/>
            <Label fx:id="feedbackLabel" textFill="red"/>
        </VBox>
    </center>
</BorderPane>