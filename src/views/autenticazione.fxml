<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AutenticazioneController"
      prefHeight="400.0" prefWidth="600.0">
    <padding>
        <Insets top="30.0" left="20.0" right="20.0" bottom="20.0"/>
    </padding>
    <Button text="Login" onAction="#handleLogin" minWidth="200"/>
    <Button text="Registrati" onAction="#handleRegister" minWidth="200"/>
</VBox>